+$fileName = Plugin::getDatabaseFileName($pluginName);
+$obj->fileName = $fileName;
+if ($fileName) {
+    $lines = file($fileName);
+    foreach ($lines as $line) {
+        if (substr($line, 0, 2) == '--' || $line == '') {

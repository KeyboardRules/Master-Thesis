+    protected function restoreValueFromDb($value)
+    {
+        if ($value && is_string($value)) {
+            $decoded = Convert::json2array($value);
+
+            if (
+                $decoded === null &&
+                $value !== 'null' &&
+                !self::config()->get('disable_unserialize') &&
+                strpos($value, 'a:') === 0 &&
+                !preg_match('/(^|;|{)O:\d+:"/', $value)
+            ) {
+                $value = unserialize($value);
+            } else {
